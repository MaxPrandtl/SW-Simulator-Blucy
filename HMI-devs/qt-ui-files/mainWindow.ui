  <property name="styleSheet">
   <string notr="true">* {
	padding: 0px;
	margin: 0px;
	color: white;
	background-color: #0B3340;
	border-radius: 10px;
}

QFrame {
	border: none;
}

QPushButton {
	border: 1px solid transparent;
	font-size: 20px;
	padding: 10px 10px;
	text-align: left;
}

QPushButton:disabled {
	color: rgba(255, 255, 255, 100);
}

QLabel[bg=&quot;none&quot;] {
	background-color: none;
}

/* Menu */

QPushButton[role=&quot;menu-btn&quot;] {
	background-color: #193849;
}

QPushButton[role=&quot;menu-btn&quot;]:hover{
	background-color: #192E39;
}

#leftMenuContainer {
	background-color:  #26526A;
	border: none;
}

#leftMenuContainer &gt; QWidget {
	background-color: none;
	border: none;
}


/* StackedWidget */

#main_content_widget QLabel {
	padding: 0;
	font-size: 20px;
}

#main_content_widget QWidget[bg=&quot;dark&quot;]{
	background-color: rgb(3, 25, 30);
}

#main_content_widget QFrame[bg=&quot;dark&quot;]{
	background-color: rgb(3, 25, 30);
}

#main_content_widget QFrame[bg=&quot;none&quot;]{
	background-color: none;
}

#main_content_widget QWidget {
	background-color: rgb(9, 40, 47);
}

#main_content_widget QPushButton[bg=&quot;primary&quot;]{
	background-color: rgb(9, 51, 64);
}

#main_content_widget QPushButton[bg=&quot;primary&quot;]:hover{
	
	background-color: rgb(9, 40, 47);
}

#main_content_widget QPushButton[bg=&quot;info&quot;]{
	background-color: rgb(31, 83, 94);
}

#main_content_widget QPushButton[bg=&quot;info&quot;]:hover{
	background-color: rgb(46, 138, 159);
}

#main_content_widget QSpinBox, QDoubleSpinBox {
	font-size: 20px;
	border-radius: none;
	border-top-left-radius: 5px;
	border-bottom-left-radius: 5px;
	padding-left: 5px;
	padding-top: 3px;
	padding-bottom: 3px;
}

#main_content_widget QDoubleSpinBox:focus, QSpinBox:focus{
	border: 2px solid rgb(45, 78, 98);
}

#main_content_widget QSpinBox::up-button, QDoubleSpinBox::up-button{ 
	width: 30px;
 }
#main_content_widget QSpinBox::down-button, QDoubleSpinBox::down-button { 
	width: 30px;
}

#main_content_widget QLabel[role=&quot;data&quot;] {
	background-color:  rgb(9, 51, 64);
	padding-left: 10px;
}


#start_sub_btn {
	padding-right: 40px;
	padding-left: 40px;
}

#stop_sub_btn {
	padding-right: 40px;
	padding-left: 40px;
}

#main_content_widget QLineEdit {
	background-color: rgb(8, 25, 29);
	font-size: 20px;
	padding: 10px;
	qproperty-frame: false ;
}

#main_content_widget QLineEdit:focus{
	border: 2px solid rgb(45, 75, 99);
	padding: 8px;
}

#main_content_widget QWidget[role=&quot;canvas&quot;] {
	background-color: rgb(7, 51, 64);
}

/* Controls */
#controls_container  {
	background-color: rgb(9, 40, 47);
}

#controls_container QWidget[bg=&quot;dark&quot;]{
	background-color: rgb(3, 25, 30);
}

#controls_container QPushButton[control=&quot;pilot-cam&quot;] {
	border: 3px solid rgb(33, 70, 119);
	text-align: center;
	border-radius: 25px;
}

#controls_container QPushButton[control=&quot;pilot-cam&quot;][status=&quot;off&quot;]{
	background-color: rgb(28, 46, 71);
}

#controls_container QPushButton[control=&quot;pilot-cam&quot;][status=&quot;off&quot;]:hover{
	background-color: rgb(33, 55, 87);
}

#controls_container QPushButton[control=&quot;pilot-cam&quot;][status=&quot;on&quot;]{
	background-color: rgb(44, 102, 211);
}

#controls_container QPushButton[control=&quot;pilot-cam&quot;][status=&quot;on&quot;]:hover{
	background-color: rgb(45, 112, 235);
}

#controls_container QPushButton[control=&quot;pilot-cam&quot;][status=&quot;shutdown&quot;]{
	background-color:  rgb(115, 109, 29);
}

#controls_container QPushButton[control=&quot;general&quot;] {
	border: 3px solid rgb(33, 70, 119);
	text-align: center;
	border-radius: 25px;
}

#controls_container QPushButton[control=&quot;general&quot;][status=false]{
	background-color: rgb(28, 46, 71);
}

#controls_container QPushButton[control=&quot;general&quot;][status=false]:hover{
	background-color: rgb(33, 55, 87);
}

#controls_container QPushButton[control=&quot;general&quot;][status=true]{
	background-color: rgb(44, 102, 211);
}

#controls_containerQPushButton[control=&quot;general&quot;][status=true]:hover{
	background-color: rgb(45, 112, 235);
}


QPushButton[control=&quot;infoled&quot;][status=&quot;off&quot;]{
	background-color: #811818;
	border:3px solid rgb(229, 30, 54);
}

QPushButton[control=&quot;infoled&quot;][status=&quot;on&quot;]{
	background-color: rgb(46, 101, 28);
	border:3px solid rgb(112, 238, 72);
}

QPushButton[control=&quot;infoled&quot;][status=&quot;warn&quot;]{
	border: 3px solid rgb(255, 178, 27);
	background-color: rgb(149, 93, 26);
}



/* Status bar*/
#status_bar {
	background-color: rgb(8, 40, 47);
}

QPushButton[status=&quot;off&quot;]{
	background-color: #811818;
	border:3px solid rgb(229, 30, 54);
}

QPushButton[status=&quot;on&quot;]{
	background-color: rgb(46, 101, 28);
	border:3px solid rgb(112, 238, 72);
}

QPushButton[status=&quot;starting&quot;]{
	border: 3px solid rgb(255, 178, 27);
	background-color: rgb(149, 93, 26);
}

/* Variable state bar*/
#state_variable_bar {
	background-color: rgb(8, 40, 47);
}

#battery_progress_bar[charge=&quot;low&quot;]:chunk{
    background-color: #F44336;
}

#battery_progress_bar[charge=&quot;medium&quot;]:chunk{
    background-color: rgb(255, 179, 26);
}

#battery_progress_bar[charge=&quot;high&quot;]:chunk{
    background-color: rgb(49, 124, 26);
}
</string>
